# ==============================================================
# UniPulse - Environment Configuration (.env)
# ระบบเฝ้าระวังและตรวจวัดสถานะอุปกรณ์ในมหาวิทยาลัย
# ==============================================================

# --- System & Monitoring Settings ---
DEFAULT_CHECK_INTERVAL=30
ALERT_CONSECUTIVE_FAILURES=2
PING_TIMEOUT=2.0
PORT_TIMEOUT=2.5
HTTP_TIMEOUT=3.5

# --- Database ---
# Default is local SQLite. For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/unipulsedb
DATABASE_URL=sqlite+aiosqlite:///./unipulse.db

# --- Telegram Notification Settings (ช่องทางแจ้งเตือนหลัก) ---
# 1. รับ Bot Token: คุยกับ @BotFather บน Telegram พิมพ์ /newbot เพื่อสร้างบอท
# 2. รับ Chat ID: คุยกับบอท @userinfobot เพื่อดู Chat ID ของตนเอง หรือนำบอทเข้ากลุ่มแอดมิน (Group ID ขึ้นต้นด้วย -100...)
TELEGRAM_BOT_TOKEN=8989169698:AAFE6Bv8SnqlaKf_CLiHRZrB16kY3kXQSMc
TELEGRAM_CHAT_ID=-5174455533
